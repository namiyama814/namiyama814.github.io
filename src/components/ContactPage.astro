---
import PageLayout from '../layouts/PageLayout.astro';
import type { Locale } from '../lib/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;

const copy = {
  ja: {
    title: 'お問い合わせ',
    lead: '制作や開発についてのご相談、質問など、お気軽にご連絡ください。内容を確認のうえ、返信いたします。',
    name: 'お名前',
    email: 'メールアドレス',
    message: 'お問い合わせ内容',
    namePlaceholder: 'お名前',
    emailPlaceholder: 'you@example.com',
    messagePlaceholder: 'お問い合わせ内容をご入力ください',
    submit: '送信する',
    required: '（必須）',
    note: '送信後はFormspreeの確認画面へ移動します。',
    subject: 'ポートフォリオサイトからのお問い合わせ',
  },
  en: {
    title: 'Get in touch',
    lead: 'For project inquiries, questions, or collaboration, please feel free to get in touch. I will review your message and reply as soon as I can.',
    name: 'Name',
    email: 'Email address',
    message: 'Message',
    namePlaceholder: 'Your name',
    emailPlaceholder: 'you@example.com',
    messagePlaceholder: 'Tell me about your inquiry',
    submit: 'Send message',
    required: '(required)',
    note: 'After submitting, you will be redirected to a Formspree confirmation page.',
    subject: 'Inquiry from portfolio site',
  },
} as const;

const t = copy[locale];
---

<PageLayout locale={locale} path="/contact" class="flex flex-col">
  <section class="section-frame border-b border-[#252525]">
    <div class="mx-auto grid max-w-7xl grid-cols-1 sm:border-x sm:border-[#252525] lg:grid-cols-12">
      <div
        class="border-b border-[#252525] px-5 py-6 sm:px-8 lg:col-span-3 lg:border-b-0 lg:border-r lg:px-10 lg:py-12"
      >
        <p class="m-0 text-[11px] font-medium tracking-[0.18em]">07 / CONTACT</p>
      </div>
      <div class="px-5 py-16 sm:px-8 lg:col-span-9 lg:px-10 lg:py-24">
        <p class="text-xs font-bold tracking-[0.17em]">{"LET'S CONNECT"}</p>
        <h1
          class="mt-7 text-[clamp(2.65rem,7vw,6.6rem)] font-black leading-[1.12] tracking-[-0.08em]"
        >
          {t.title}
        </h1>
        <p class="mt-8 max-w-2xl text-sm leading-8 sm:text-base">{t.lead}</p>
      </div>
    </div>
  </section>

  <section class="selection-on-dark flex-1 bg-[#252525] text-[#FAFAFA]">
    <div class="mx-auto max-w-7xl sm:border-x sm:border-[#FAFAFA]">
      <form
        action="https://formspree.io/f/xgawlzep"
        method="POST"
        class="mx-auto max-w-4xl px-5 py-12 sm:px-8 lg:px-10 lg:py-20"
      >
        <input type="hidden" name="_subject" value={t.subject} />
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <label class="flex flex-col gap-3 text-xs font-bold tracking-[0.08em]">
            {t.name}
            <span class="sr-only">{t.required}</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder={t.namePlaceholder}
              class="min-h-12 border-b border-[#FAFAFA] bg-transparent px-0 py-3 text-base font-medium tracking-normal text-[#FAFAFA] outline-none transition-[border-width] placeholder:text-[#FAFAFA]/60 focus-visible:border-b-2 focus-visible:border-[#FAFAFA]"
            />
          </label>
          <label class="flex flex-col gap-3 text-xs font-bold tracking-[0.08em]">
            {t.email}
            <span class="sr-only">{t.required}</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder={t.emailPlaceholder}
              class="min-h-12 border-b border-[#FAFAFA] bg-transparent px-0 py-3 text-base font-medium tracking-normal text-[#FAFAFA] outline-none transition-[border-width] placeholder:text-[#FAFAFA]/60 focus-visible:border-b-2 focus-visible:border-[#FAFAFA]"
            />
          </label>
        </div>
        <label class="mt-10 flex flex-col gap-3 text-xs font-bold tracking-[0.08em]">
          {t.message}
          <span class="sr-only">{t.required}</span>
          <textarea
            name="message"
            required
            rows="7"
            placeholder={t.messagePlaceholder}
            class="min-h-40 resize-y border-b border-[#FAFAFA] bg-transparent px-0 py-3 text-base font-medium leading-7 tracking-normal text-[#FAFAFA] outline-none transition-[border-width] placeholder:text-[#FAFAFA]/60 focus-visible:border-b-2 focus-visible:border-[#FAFAFA]"
          ></textarea>
        </label>
        <div
          class="mt-10 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center"
        >
          <p class="m-0 text-xs leading-6 text-[#FAFAFA]/75">{t.note}</p>
          <button
            type="submit"
            class="min-h-12 border border-[#FAFAFA] px-5 py-3 text-xs font-bold tracking-[0.12em] transition-colors hover:bg-[#FAFAFA] hover:text-[#252525] focus-visible:bg-[#FAFAFA] focus-visible:text-[#252525] focus-visible:outline-none"
          >
            {t.submit}
          </button>
        </div>
      </form>
    </div>
  </section>
</PageLayout>
