---
import type { HomeCopy } from '../../data/homeContent';
import SectionLabel from '../SectionLabel.astro';
import TextLines from '../TextLines.astro';
import SparkIcon from '../icons/SparkIcon.astro';
import LayersIcon from '../icons/LayersIcon.astro';
import CodeIcon from '../icons/CodeIcon.astro';

type Props = {
  copy: HomeCopy;
};

const { copy } = Astro.props;
const qualityIcons = [SparkIcon, LayersIcon, CodeIcon];
---

<section id="about" class="section-frame border-b border-[#252525]">
  <div class="mx-auto grid max-w-7xl grid-cols-1 sm:border-x sm:border-[#252525] lg:grid-cols-12">
    <div
      class="border-b border-[#252525] px-5 py-6 sm:px-8 lg:col-span-3 lg:border-b-0 lg:border-r lg:px-10 lg:py-12"
    >
      <SectionLabel number="01">ABOUT</SectionLabel>
    </div>
    <div class="px-5 py-16 sm:px-8 lg:col-span-9 lg:px-10 lg:py-24">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <h2
            class="max-w-4xl text-[clamp(1.8rem,4vw,4rem)] font-black leading-[1.35] tracking-[-0.07em]"
          >
            <TextLines lines={copy.aboutTitleLines} />
          </h2>
          <p class="mt-7 max-w-2xl text-sm leading-8 sm:text-base">{copy.aboutLead}</p>
        </div>
        <figure class="m-0 w-32 sm:w-40">
          <img
            src="/avatar/source.png"
            alt="namiyamaのGitHubアバター"
            width="160"
            height="160"
            class="aspect-square w-full rounded-full border border-[#252525] object-cover"
          />
          <figcaption class="mt-3 text-center text-[10px] font-bold tracking-[0.13em]">
            namiyama
          </figcaption>
        </figure>
      </div>
      <div
        class="mt-12 grid max-w-4xl grid-cols-1 gap-px border border-[#252525] bg-[#252525] text-sm md:grid-cols-3"
      >
        {
          copy.qualities.map((quality, index) => {
            const Icon = qualityIcons[index];
            return (
              <article class="bg-[#FAFAFA] p-5 sm:p-6">
                <Icon />
                <h3 class="mt-7 text-sm font-black tracking-[-0.04em]">{quality.title}</h3>
                <p class="mt-3 leading-7">
                  <TextLines lines={quality.descriptionLines} />
                </p>
              </article>
            );
          })
        }
      </div>
      <p class="mt-8 max-w-3xl text-sm leading-8">{copy.aboutNote}</p>
    </div>
  </div>
</section>
