---
import { alternateLocale, localizePath, type Locale, type LocalizedPath } from '../lib/i18n';
import ArrowUpRightIcon from './icons/ArrowUpRightIcon.astro';

type Props = {
  locale: Locale;
  path: LocalizedPath;
};

const { locale, path } = Astro.props;
const home = localizePath(locale, '/');
const alternate = localizePath(alternateLocale(locale), path);
const switcherLocale = alternateLocale(locale);
const labels =
  locale === 'en'
    ? { contact: 'CONTACT', switcher: 'JP', language: '日本語に切り替える' }
    : { contact: 'CONTACT', switcher: 'EN', language: 'Switch to English' };
---

<header class="fixed inset-x-0 top-0 z-30 border-b border-[#252525] bg-[#FAFAFA]">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8 lg:px-10">
    <a href={home} class="shrink-0 text-lg font-black tracking-[-0.08em]">
      namiyama<span class="ml-0.5">.</span>
    </a>
    <nav
      aria-label={locale === 'en' ? 'Main navigation' : 'メインナビゲーション'}
      class="hidden items-center gap-5 text-[10px] font-bold tracking-[0.12em] md:flex"
    >
      <a href={`${home}#about`} class="transition-opacity hover:opacity-60">ABOUT</a>
      <a href={`${home}#skills`} class="transition-opacity hover:opacity-60">SKILLS</a>
      <a href={`${home}#career`} class="transition-opacity hover:opacity-60">CAREER</a>
      <a href={localizePath(locale, '/works')} class="transition-opacity hover:opacity-60">WORKS</a>
      <a href={localizePath(locale, '/contact')} class="transition-opacity hover:opacity-60"
        >{labels.contact}</a
      >
    </nav>
    <div class="flex shrink-0 items-center gap-4 text-[10px] font-bold tracking-[0.12em]">
      <a
        href={alternate}
        aria-label={`${labels.switcher} — ${labels.language}`}
        class="border-b border-[#252525] pb-0.5 transition-opacity hover:opacity-60"
        data-locale-preference={switcherLocale}
      >
        {labels.switcher}
      </a>
      <a
        href="https://github.com/namiyama814"
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-1.5 border-b border-[#252525] pb-0.5 transition-opacity hover:opacity-60 sm:inline-flex"
      >
        GITHUB <ArrowUpRightIcon />
      </a>
    </div>
  </div>
</header>

<script src="../scripts/locale-preference.ts"></script>
